# ============================================
# Monmouth L2 Node Configuration
# ============================================
#
# This file documents all environment variables used by the Monmouth L2 node.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values in .env
# 3. NEVER commit .env to git (it's in .gitignore)
#
# ============================================

# ============================================
# L1 Integration (Required for Bridge)
# ============================================

# L1 RPC URL - Ethereum Sepolia testnet endpoint
#
# Get from Alchemy (recommended):
#   1. Sign up at https://www.alchemy.com/
#   2. Create App -> Chain: Ethereum, Network: Sepolia
#   3. Copy HTTPS URL
#
# Or use Infura: https://www.infura.io/
#
# Example: https://eth-sepolia.g.alchemy.com/v2/abc123def456...
L1_RPC_URL=

# Sequencer private key - Used to sign L1 transactions
#
# Generate with Foundry:
#   cast wallet new
#
# Or in code:
#   use alloy_signer_local::PrivateKeySigner;
#   let signer = PrivateKeySigner::random();
#
# SECURITY: KEEP THIS SECRET! Never commit to git!
# Format: 0x followed by 64 hex characters
# Example: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SEQUENCER_PRIVATE_KEY=

# L1 Contract Addresses (deployed on Sepolia)
#
# Deploy all contracts with:
#   cd contracts && forge script script/Deploy.s.sol --rpc-url $L1_RPC_URL --broadcast
#
# Current Sepolia Deployment (December 2025):
L1_SEQUENCER_INBOX=0x6Bd9d243d7a7bcA54234555cF413c3BC39920c30
L1_STATE_COMMITMENT_CHAIN=0x95E4fE47413671aCF43110d535b6F27706FF3b0f
L1_BRIDGE_ADDRESS=0x6277da33eC7064Fb323061f009C443ff94A00370
L1_CROSS_DOMAIN_MESSENGER=0xB8E14d04934d01666bf86EEb3C371Bc20B24a6b1

# Etherscan API Key (for contract verification)
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ============================================
# Node Configuration
# ============================================

# Logging level
# Options: trace, debug, info, warn, error
# Use debug for development, info for production
# Example: RUST_LOG=info,monmouth=debug
RUST_LOG=info

# Data directory for blockchain data
# Default: ./data
DATA_DIR=./data

# Chain specification
# Use genesis.json for custom chain
# Default: ./genesis.json
CHAIN=./genesis.json

# ============================================
# RPC Configuration
# ============================================

# HTTP JSON-RPC port
# Default: 8545
HTTP_PORT=8545

# HTTP bind address
# Use 0.0.0.0 to allow external connections
# Use 127.0.0.1 for localhost only
# Default: 0.0.0.0
HTTP_ADDR=0.0.0.0

# WebSocket RPC port
# Default: 8546
WS_PORT=8546

# WebSocket bind address
# Default: 0.0.0.0
WS_ADDR=0.0.0.0

# Engine API port (for consensus clients)
# Default: 8551
ENGINE_PORT=8551

# Prometheus metrics port
# Access metrics at http://localhost:9001/metrics
# Default: 9001
METRICS_PORT=9001

# ============================================
# ExEx Configuration
# ============================================

# ExEx host gRPC address
# This is where the ExEx host service listens
# Default: 127.0.0.1:50051
EXEX_HOST_ADDR=127.0.0.1:50051

# External ExEx service endpoint (optional)
# If you have a separate ML classification service
# Example: http://localhost:50052
EXEX_ENDPOINT=

# Classification confidence threshold
# Range: 0.0 to 1.0 (0.0 = accept all, 1.0 = only certain)
# Default: 0.7
CONFIDENCE_THRESHOLD=0.7

# ============================================
# Sequencer Configuration
# ============================================

# Enable sequencer mode
# Set to "true" to run as sequencer, "false" for regular node
# Default: false
ENABLE_SEQUENCER=false

# Enable agent-aware transaction pool
# Classifies transactions by type (EVM, SVM, Hybrid, etc.)
# Default: false
ENABLE_AGENT_POOL=false

# Enable ExEx host service
# Starts gRPC service for ExEx communication
# Default: false
ENABLE_EXEX_HOST=false

# Enable transaction context fetching
# Fetches additional context for RAG-enhanced transactions
# Default: false
ENABLE_CONTEXT=false

# ============================================
# Testnet Faucets (For Reference)
# ============================================
#
# Get free Sepolia ETH from:
#   - Alchemy: https://sepoliafaucet.com/
#   - Infura: https://www.infura.io/faucet/sepolia
#   - QuickNode: https://faucet.quicknode.com/ethereum/sepolia
#
# You'll need ~0.5-1.0 ETH to:
#   - Deploy L1 contracts
#   - Submit batches to L1
#   - Test deposits/withdrawals

# ============================================
# Future/Optional Configuration
# ============================================

# OpenAI API Key (for Intent Parser precompile - Phase 2)
# Get from: https://platform.openai.com/api-keys
# Only needed if implementing Intent Parser with OpenAI
# OPENAI_API_KEY=

# Anthropic API Key (alternative for Intent Parser)
# Get from: https://console.anthropic.com/
# Only needed if using Anthropic instead of OpenAI
# ANTHROPIC_API_KEY=

# ============================================
# Development Notes
# ============================================
#
# Recommended setup for development:
#   L1_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   SEQUENCER_PRIVATE_KEY=0xYOUR_KEY
#   RUST_LOG=info,monmouth=debug
#   ENABLE_SEQUENCER=false
#   ENABLE_AGENT_POOL=false
#   ENABLE_EXEX_HOST=false
#
# Recommended setup for sequencer:
#   L1_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   SEQUENCER_PRIVATE_KEY=0xYOUR_KEY
#   L1_BRIDGE_ADDRESS=0xYOUR_DEPLOYED_ADDRESS
#   L1_BATCH_INBOX_ADDRESS=0xYOUR_DEPLOYED_ADDRESS
#   RUST_LOG=info
#   ENABLE_SEQUENCER=true
#   ENABLE_AGENT_POOL=true
#   ENABLE_EXEX_HOST=true
#   ENABLE_CONTEXT=true
#
# ============================================
